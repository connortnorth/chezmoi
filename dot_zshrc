wp() {
  # Display help
  if [[ "$1" == "-h" || "$1" == "--help" || -z "$1" ]]; then
    cat << 'EOF'
Usage: wp [OPTION] [DIR | IMAGE_PATH]

Manages KDE Plasma wallpapers with automated visual previews via chafa.

Options:
  -r, r [DIR]    Set a random wallpaper from DIR (default: $HOME/wallpapers).
                 Automatically avoids selecting the currently active wallpaper.
  -s, s [DIR]    Select a wallpaper interactively from DIR using rofi.
  -h, --help     Display this help message and exit.

Arguments:
  <IMAGE_PATH>    Direct path to an image file to set as wallpaper.

Examples:
  wp /path/to/image.jpg
  wp -r
  wp -r ~/Pictures/Wallpapers
  wp -s
EOF
    return 0
  fi

  # Helper to set wallpaper and show inline terminal preview
  _apply_wp() {
    local img="$1"
    if [[ ! -f "$img" ]]; then
      echo "Error: File '$img' does not exist." >&2
      return 1
    fi

    plasma-apply-wallpaperimage "$img"
    chafa "$img"
  }

  # Helper to resolve and validate input directory
  _get_dir() {
    local dir="${1:-$HOME/wallpapers}"
    if [[ ! -d "$dir" ]]; then
      echo "Error: Directory '$dir' does not exist." >&2
      return 1
    fi
    echo "$dir"
  }

  case "$1" in
    -r|r)
      local dir
      dir=$(_get_dir "$2") || return 1

      # Retrieve active wallpaper path from Plasma config
      local current_wp=""
      local plasma_cfg="$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
      if [[ -f "$plasma_cfg" ]]; then
        current_wp=$(grep -m 1 "^Image=" "$plasma_cfg" | cut -d '=' -f 2- | sed 's|^file://||')
      fi

      # Collect image files strictly using find (ignores hidden files & matches extensions case-insensitively)
      local images=()
      while IFS= read -r -d '' file; do
        images+=("$file")
      done < <(find "$dir" -maxdepth 1 -type f ! -name ".*" \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" -o -iname "*.svg" \) -print0 2>/dev/null)

      # Filter out current wallpaper from array
      local candidates=()
      for img in "${images[@]}"; do
        [[ "$img" != "$current_wp" ]] && candidates+=("$img")
      done

      local random_img
      if (( ${#candidates[@]} > 0 )); then
        random_img=${candidates[RANDOM % ${#candidates[@]}]}
      elif (( ${#images[@]} > 0 )); then
        random_img=${images[RANDOM % ${#images[@]}]}
      else
        echo "Error: No valid image files found in '$dir'." >&2
        return 1
      fi

      _apply_wp "$random_img"
      ;;

    -s|s)
      local dir
      dir=$(_get_dir "$2") || return 1

      # Collect image files strictly using find
      local images=()
      while IFS= read -r -d '' file; do
        images+=("$file")
      done < <(find "$dir" -maxdepth 1 -type f ! -name ".*" \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" -o -iname "*.svg" \) -print0 2>/dev/null)

      if (( ${#images[@]} == 0 )); then
        echo "Error: No valid image files found in '$dir'." >&2
        return 1
      fi

      local selected_img
      selected_img=$(printf '%s\n' "${images[@]}" | rofi -dmenu -i -p "Select Wallpaper:")

      [[ -n "$selected_img" ]] && _apply_wp "$selected_img"
      ;;

    *)
      _apply_wp "$1"
      ;;
  esac
}

